function __S(v) {
    if (typeof(v) == "number" && v >= 0 && v < array_length(global.__SPR)) return global.__SPR[v];
    return v;
}

function __SR(v) {
    if (typeof(v) == "number" && v < 0) return v;
    if (!sprite_exists(v)) return -1;
    var n = global.__SPRR[$ sprite_get_name(v)];
    return is_undefined(n) ? v : n;
}

function __A(v) {
    if (typeof(v) == "number" && v >= 0 && v < array_length(global.__SND)) return global.__SND[v];
    return v;
}

/// GMS1 instance_create: instances take the depth of their object.
function __c_instance_create(_x, _y, _obj) {
    var d = global.__ODEPTH[$ object_get_name(_obj)];
    return instance_create_depth(_x, _y, is_undefined(d) ? 0 : d, _obj);
}

/// GMS1: height of a 2D array = number of rows (1 for a 1D array).
function __c_array_height_2d(a) {
    if (!is_array(a)) return 0;
    var n = array_length(a);
    if (n == 0) return 0;
    for (var i = 0; i < n; i++) if (is_array(a[i])) return n;
    return 1;
}

/// GMS1: length of a 1D array, or of row 0 of a 2D array.
function __c_array_length_1d(a) {
    if (!is_array(a)) return 0;
    if (array_length(a) > 0 && is_array(a[0])) return array_length(a[0]);
    return array_length(a);
}

/// UI size on phones. The game was designed for a 574 px high screen and caps
/// its UI scale A at 1, so on a retina iPhone (~1179 px) everything was half
/// size. The game now sees a logical resolution with the short side ~574 px;
/// UI_SCALE enlarges the UI further (1 = original design proportions).
#macro UI_SCALE 1.0
#macro UI_DESIGN_HEIGHT 574

function __c_win_div() {
    var w = window_get_width(), h = window_get_height();
    return max(1, min(w, h) / UI_DESIGN_HEIGHT);
}
function __c_win_w() { return window_get_width() / __c_win_div(); }
function __c_win_h() { return window_get_height() / __c_win_div(); }
function __c_mouse_x() { return window_mouse_get_x() / __c_win_div(); }
function __c_mouse_y() { return window_mouse_get_y() / __c_win_div(); }

/// Keep the application surface the same size as view 0's port, so the
/// view is drawn 1:1 and the surface has the screen's aspect ratio.
function __c_sync_appsurf() {
    var w = round(view_wport[0]), h = round(view_hport[0]);
    if (w <= 0 || h <= 0 || !surface_exists(application_surface)) return;
    if (surface_get_width(application_surface) != w || surface_get_height(application_surface) != h)
        surface_resize(application_surface, w, h);
}

/// In-app purchases are not available in this port.
function __c_iap_acquire(product, payload) {
    show_debug_message("[compat] iap_acquire(" + string(product) + ") ignored");
    return -1;
}


